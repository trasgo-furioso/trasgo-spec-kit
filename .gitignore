# Bundle build artifacts (root-level ZIPs are tracked; bundle/ copies are not)
dist/
bundle/*.zip

# Spec Kit installed extensions and cache (generated on `specify bundle install`)
.specify/extensions/
.specify/bundle-records.json

# Auto-generated skill files from installed extensions
.claude/skills/speckit-trasgospec-*/

